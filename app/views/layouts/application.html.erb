<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Vault" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="bg-gradient-to-r from-indigo-900 to-purple-900 text-white shadow-lg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center space-x-2">
            <span class="text-2xl">🔐</span>
            <span class="font-bold text-xl tracking-tight">Vault</span>
            <span class="text-xs text-indigo-300 bg-indigo-800 px-2 py-0.5 rounded-full">Secure</span>
          </div>
          
          <div class="flex items-center space-x-4">
            <% if user_signed_in? %>
              <span class="text-sm text-indigo-200 hidden sm:inline">
                <%= current_user.email %>
              </span>
              <div class="flex space-x-2">
                <%= button_to "Logout", destroy_user_session_path, method: :delete, 
                    class: "bg-red-600 hover:bg-red-700 text-white px-4 py-1.5 rounded-lg text-sm font-medium transition duration-200" %>
                <%= button_to "Delete Account", user_registration_path, method: :delete, 
                    data: { confirm: "Are you sure? This will permanently delete your account and all your vaults." },
                    class: "bg-gray-600 hover:bg-gray-700 text-white px-4 py-1.5 rounded-lg text-sm font-medium transition duration-200" %>
              </div>
            <% else %>
              <% unless devise_controller? %>
                <%= link_to "Log in", new_user_session_path, 
                    class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-1.5 rounded-lg text-sm font-medium transition duration-200" %>
                <%= link_to "Sign up", new_user_registration_path, 
                    class: "bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-1.5 rounded-lg text-sm font-medium transition duration-200" %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
      <% if notice %>
        <div class="bg-emerald-50 border-l-4 border-emerald-500 p-4 rounded-lg shadow-sm" role="alert">
          <p class="text-emerald-700"><%= notice %></p>
        </div>
      <% end %>
      <% if alert %>
        <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-lg shadow-sm" role="alert">
          <p class="text-red-700"><%= alert %></p>
        </div>
      <% end %>
    </div>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>
  </body>
</html>