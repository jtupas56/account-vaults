<div class="min-h-[80vh] flex items-center justify-center">
  <div class="bg-white rounded-2xl shadow-xl border border-gray-200 p-8 max-w-md w-full">
    <div class="text-center mb-8">
      <div class="text-4xl mb-2">🔐</div>
      <h2 class="text-2xl font-bold text-gray-900">Welcome Back</h2>
      <p class="text-sm text-gray-500 mt-1">Log in to your Vault account</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", 
            class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200",
            placeholder: "you@example.com" %>
      </div>

      <div>
        <div class="flex justify-between items-center">
          <%= f.label :password, class: "block text-sm font-medium text-gray-700" %>
          <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-xs text-blue-600 hover:text-blue-800" %>
        </div>
        <%= f.password_field :password, autocomplete: "current-password", 
            class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200",
            placeholder: "••••••••" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center">
          <%= f.check_box :remember_me, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
          <%= f.label :remember_me, class: "ml-2 block text-sm text-gray-700" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "Log in", class: "w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition duration-200 shadow-sm cursor-pointer" %>
      </div>
    <% end %>

    <div class="mt-6 text-center text-sm">
      <p class="text-gray-600">
        Don't have an account? 
        <%= link_to "Sign up", new_registration_path(resource_name), class: "text-blue-600 hover:text-blue-800 font-medium" %>
      </p>
    </div>
  </div>
</div>