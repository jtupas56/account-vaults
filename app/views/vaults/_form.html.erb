<%= form_with(model: vault, class: "max-w-2xl mx-auto") do |form| %>
  <% if vault.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-lg shadow-sm mb-6">
      <h2 class="text-sm font-semibold text-red-800">
        <%= pluralize(vault.errors.count, "error") %> prohibited this vault from being saved:
      </h2>
      <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
        <% vault.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-6">
    <div class="space-y-5">
      <div>
        <%= form.label :site, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :site, 
            class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200",
            placeholder: "e.g., Google" %>
      </div>

      <div>
        <%= form.label :url, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :url, 
            class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200",
            placeholder: "https://example.com" %>
      </div>

      <div>
        <%= form.label :login, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :login, 
            class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200",
            placeholder: "username, email or id" %>
      </div>

      <div>
        <%= form.label :password, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :password, 
            class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200",
            placeholder: "••••••••" %>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <%= form.submit class: "px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition duration-200 shadow-sm" %>
      <%= link_to "Back", vaults_path, 
          class: "px-6 py-2.5 bg-gray-500 hover:bg-gray-600 text-white rounded-lg font-medium transition duration-200" %>
    </div>
  </div>
<% end %>